# Firmware downloads, release metadata, and runtime state
/meshcore-dev_MeshCore/
/meshtastic_firmware/

# Runtime dependencies downloaded by the Windows scripts
/winpython/
/USBDeview.exe

# Temporary script output
/.tmp/
/tmp_*
/usb_devices.xml
/meshtastic_outputCOM*.txt
/meshtastic_errorCOM*.txt
/*.serial-dfu.hex
/*.serial-dfu.zip

# Python helper and test caches
__pycache__/
*.py[cod]

# Generated USB migration utility set (rebuild from the MeshCore recipe)
/tools/meshcore-usb-partition-bridges.zip

# Local device configuration and backups (may contain credentials)
/config.yaml
/config_backup.*.yaml*
/mt.config_backup.*.yaml*
/mc.config_backup.*.json

# Browser flasher dependencies and generated public output
/web/node_modules/
/web/dist/
/web/public/python/
/web/public/validators/
/web/public/catalog.json
/web/public/licenses/
/web/public/THIRD_PARTY_NOTICES.txt
/web/test-results/
/web/playwright-report/
